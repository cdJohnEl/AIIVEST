# ============================================
# AIVEST — .gitignore
# ============================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build Outputs ----
dist/
dist-ssr/
build/

# ---- Environment & Secrets ----
# NEVER commit these files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ---- Firebase Admin SDK Service Account Keys ----
# These are private server-side credentials and must NEVER be committed
*.json
!package.json
!package-lock.json
!jsconfig.json
!tsconfig.json
!tsconfig.*.json
!components.json

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Testing ----
coverage/
*.lcov

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---- Vite & TypeScript ----
*.tsbuildinfo

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
