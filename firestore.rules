rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the current user is an Admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Ensure the user is authenticated 
    function isAuthenticated() {
      return request.auth != null;
    }

    // USER PROFILES — PII is restricted to the owner and admins.
    // Referral code lookups happen via the public /referralCodes collection below.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // REFERRAL CODE LOOKUP — public read-only map of code -> ownerUid.
    // Lets a new user resolve a referral code at registration without
    // reading the (private) /users collection.
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null
                       && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // DENORMALIZED REFERRAL LIST — only what the referrer dashboard needs.
    // /referrals/{ownerUid}/list/{refereeUid}
    // Created by the referee at signup; read by the owner on their dashboard.
    match /referrals/{ownerUid}/list/{refereeUid} {
      allow read: if request.auth.uid == ownerUid || isAdmin();
      allow create: if request.auth != null
                       && request.auth.uid == refereeUid
                       && request.resource.data.refereeUid == request.auth.uid;
      allow update: if request.auth.uid == refereeUid || isAdmin();
      allow delete: if isAdmin();
    }

    // PORTFOLIOS
    match /portfolios/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      
      // Allow the user to create their initial portfolio during registration
      allow create: if request.auth.uid == userId;
      
      // Only Admins can update balances or returns
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // INVESTMENTS 
    match /investments/{investmentId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      
      // Users can create investments, but they cannot legally bypass
      // setting the status to 'pending' unless they are an admin.
      allow create: if request.auth.uid == request.resource.data.userId &&
                       (request.resource.data.status == 'pending' || isAdmin());
                       
      // Users cannot update or delete. Only admins can update the status/details.
      allow update, delete: if isAdmin();
    }

    // TRANSACTIONS (Deposits/Withdrawals)
    match /transactions/{transactionId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      
      allow create: if request.auth.uid == request.resource.data.userId &&
                       (request.resource.data.status == 'pending' || 
                        request.resource.data.status == 'detected' || 
                        isAdmin());
                        
      allow update, delete: if isAdmin();
    }

    // BLOG POSTS (Public Read, Admin Write)
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
